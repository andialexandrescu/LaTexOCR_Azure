# Pure-Python entrypoint (python app.py) WITH pix2tex installed.
# Uses Python 3.11 because pix2tex/torch support is much more reliable here than 3.13.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    poppler-utils \
    # libmagic1 \
    libglib2.0-0 \
    libgl1 \
    git \
    git-lfs \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "from pix2tex.cli import LatexOCR; LatexOCR()"

RUN git clone https://github.com/opendatalab/UniMERNet.git /app/UniMERNet
ENV PYTHONPATH="/app/UniMERNet:${PYTHONPATH}"
RUN cd /app/UniMERNet/models && git lfs install && git clone https://huggingface.co/wanderkid/unimernet_small

RUN MODEL_DIR=/app/UniMERNet/models/unimernet_small && \
    if [ -f "$MODEL_DIR/pytorch_model.pth" ]; then \
        mv "$MODEL_DIR/pytorch_model.pth" "$MODEL_DIR/unimernet_small.pth"; \
    fi && \
    test -f /app/UniMERNet/configs/demo.yaml && \
    sed -i \
      -e 's|./models/unimernet_base|/app/UniMERNet/models/unimernet_small|g' \
      -e 's|unimernet_base.pth|unimernet_small.pth|g' \
      /app/UniMERNet/configs/demo.yaml

COPY app.py .
COPY formula_detector.py .
COPY index.html .
COPY results.html .
COPY floating-formulas.txt .
COPY static ./static

EXPOSE 8000

CMD ["python", "app.py"]
